{
  "family": "blog-sample-app-{{ must_env `ENV` }}",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::{{ must_env `AWS_ACCOUNT_ID` }}:role/blog-sample-app-{{ must_env `ENV` }}-task-execution",
  "taskRoleArn": "arn:aws:iam::{{ must_env `AWS_ACCOUNT_ID` }}:role/blog-sample-app-{{ must_env `ENV` }}-task",
  "containerDefinitions": [
    {
      "name": "app",
      "image": "{{ must_env `IMAGE` }}",
      "essential": true,
      "portMappings": [
        { "containerPort": 8080, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "APP_ENV", "value": "{{ must_env `ENV` }}" },
        { "name": "PORT", "value": "8080" }
      ],
      "stopTimeout": 30,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/blog-sample-app-{{ must_env `ENV` }}",
          "awslogs-region": "{{ must_env `AWS_REGION` }}",
          "awslogs-stream-prefix": "app"
        }
      }
    }
  ]
}
