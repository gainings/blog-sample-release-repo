{
  "launchType": "FARGATE",
  "platformVersion": "LATEST",
  "desiredCount": 2,
  "deploymentController": {
    "type": "ECS"
  },
  "deploymentConfiguration": {
    "deploymentCircuitBreaker": {
      "enable": true,
      "rollback": true
    },
    "maximumPercent": 200,
    "minimumHealthyPercent": 100
  },
  "healthCheckGracePeriodSeconds": 30,
  "enableExecuteCommand": false,
  "loadBalancers": [
    {
      "containerName": "app",
      "containerPort": 8080,
      "targetGroupArn": "arn:aws:elasticloadbalancing:ap-northeast-1:333333333333:targetgroup/blog-sample-app-prd/0123456789abcdef"
    }
  ],
  "networkConfiguration": {
    "awsvpcConfiguration": {
      "assignPublicIp": "DISABLED",
      "subnets": [
        "subnet-0prd000000000001",
        "subnet-0prd000000000002"
      ],
      "securityGroups": [
        "sg-0prd00000000000"
      ]
    }
  },
  "propagateTags": "SERVICE",
  "tags": [
    {
      "key": "Environment",
      "value": "prd"
    },
    {
      "key": "ManagedBy",
      "value": "ecspresso"
    }
  ]
}
