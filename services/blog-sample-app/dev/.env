# ecspresso --envfile で読み込まれる。値はアプリ側 CI (scripts/set-image.sh) が書き換える。
# 変数名は自由。値のリポジトリ (registry/repository) が一致する行が更新対象になる。
IMAGE=111111111111.dkr.ecr.ap-northeast-1.amazonaws.com/blog-sample-app:sha-8428f66887f892e8a2f9622024cc180f0661a8eb
IMAGE_NGINX=111111111111.dkr.ecr.ap-northeast-1.amazonaws.com/blog-sample-app-nginx:sha-8428f66887f892e8a2f9622024cc180f0661a8eb
