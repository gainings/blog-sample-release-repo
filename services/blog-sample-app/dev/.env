# ecspresso --envfile で読み込まれる。値はアプリ側 CI (scripts/set-image.sh) が書き換える。
# 変数名は自由。値のリポジトリ (registry/repository) が一致する行が更新対象になる。
IMAGE=111111111111.dkr.ecr.ap-northeast-1.amazonaws.com/blog-sample-app:sha-2ebcddf5dd4422e5b77a59d3468f325f4c7aacfb
IMAGE_NGINX=111111111111.dkr.ecr.ap-northeast-1.amazonaws.com/blog-sample-app-nginx:sha-2ebcddf5dd4422e5b77a59d3468f325f4c7aacfb
