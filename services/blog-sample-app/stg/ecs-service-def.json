{
  "launchType": "FARGATE",
  "platformVersion": "LATEST",
  "desiredCount": 1,
  "deploymentController": {
    "type": "ECS"
  },
  "deploymentConfiguration": {
    "deploymentCircuitBreaker": {
      "enable": true,
      "rollback": true
    },
    "maximumPercent": 200,
    "minimumHealthyPercent": 100
  },
  "healthCheckGracePeriodSeconds": 30,
  "enableExecuteCommand": true,
  "loadBalancers": [
    {
      "containerName": "nginx",
      "containerPort": 80,
      "targetGroupArn": "arn:aws:elasticloadbalancing:ap-northeast-1:222222222222:targetgroup/blog-sample-app-stg/0123456789abcdef"
    }
  ],
  "networkConfiguration": {
    "awsvpcConfiguration": {
      "assignPublicIp": "DISABLED",
      "subnets": [
        "subnet-0stg000000000001",
        "subnet-0stg000000000002"
      ],
      "securityGroups": [
        "sg-0stg00000000000"
      ]
    }
  },
  "propagateTags": "SERVICE",
  "tags": [
    {
      "key": "Environment",
      "value": "stg"
    },
    {
      "key": "ManagedBy",
      "value": "ecspresso"
    }
  ]
}
