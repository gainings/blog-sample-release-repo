{
  "FunctionName": "example-lambda-{{ must_env `ENV` }}",
  "PackageType": "Image",
  "Code": {
    "ImageUri": "{{ must_env `IMAGE` }}"
  },
  "Role": "arn:aws:iam::{{ must_env `AWS_ACCOUNT_ID` }}:role/example-lambda-{{ must_env `ENV` }}-exec",
  "Architectures": ["x86_64"],
  "MemorySize": {{ must_env `MEMORY_SIZE` }},
  "Timeout": 30,
  "Environment": {
    "Variables": {
      "APP_ENV": "{{ must_env `ENV` }}"
    }
  },
  "Tags": {
    "Environment": "{{ must_env `ENV` }}",
    "ManagedBy": "lambroll"
  }
}
